  "name": "SEO Agent – 07 Local SEO Monitor",
  "nodes": [
    {
      "id": "ed7c9857-0eb0-409f-a837-dec48358dc1c",
      "parameters": {
        "content": "## SEO Agent – 07 Local SEO Monitor\nSearch data → Location analysis → Service × Location opportunities (Coimbatore / Tamil Nadu / India first) → Recommendations. New location pages are only suggested with real demand evidence; no thin doorway pages.\n\nRequires n8n env vars: SEO_API_URL, SEO_API_KEY (service key), SEO_PROJECT_ID. All logic runs in the SEO Agent API; every call is retried 3× and failures trigger the Error Handler workflow.",
        "width": 520,
        "height": 260
      },
      "name": "Note cd0125",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -260
      ]
    },
    {
      "id": "4a732845-8970-41f1-ae24-7bafd235532a",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * 4"
            }
          ]
        }
      },
      "name": "Every Thursday 03:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "2ea1dfa3-a652-423e-ae57-4ebf0fc26f06",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SEO_API_URL }}/api/projects/{{ $env.SEO_PROJECT_ID }}/jobs/local-seo?wait=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.SEO_API_KEY }}"
            },
            {
              "name": "x-correlation-id",
              "value": "=local-seo-{{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"useAi\": true }",
        "options": {
          "timeout": 1800000
        }
      },
      "name": "Local SEO analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000
    },
    {
      "id": "9981b68e-400e-4de6-ae63-0fada0000bce",
      "parameters": {
        "jsCode": "// Summarise job output for the execution log (visible in n8n → Executions).\nconst r = $input.first().json;\nreturn [{ json: { workflow: 'local-seo', status: r.status, jobId: r.jobId, correlationId: r.correlationId, output: r.output, finishedAt: new Date().toISOString() } }];"
      },
      "name": "Log summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
