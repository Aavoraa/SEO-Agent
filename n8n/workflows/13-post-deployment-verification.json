{
  "id": "pxSeoPostDeploy1",
  "name": "SEO Agent – 13 Post-Deployment Verification",
  "nodes": [
    {
      "id": "0777bd91-5836-4195-a190-9998f8f1ebd9",
      "parameters": {
        "content": "## SEO Agent – 13 Post-Deployment Verification\nHourly: re-crawl pages whose deployment was flagged VERIFICATION_FAILED in the last 48 h (CDN/page caches often catch up) → mark VERIFIED when the live page matches → re-score the audit. Anything still failing stays flagged with rollback available in the dashboard.\n\nRequires n8n env vars: SEO_API_URL, SEO_API_KEY (service key), SEO_PROJECT_ID. All logic runs in the SEO Agent API; every call is retried 3× and failures trigger the Error Handler workflow.",
        "width": 520,
        "height": 260
      },
      "name": "Note 94cbb2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -260
      ]
    },
    {
      "id": "0d418181-099b-4ddf-a6de-6739594db2d6",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "15 * * * *"
            }
          ]
        }
      },
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "b2b96ad1-721c-4f6f-afc3-2fa28b2b0bda",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SEO_API_URL }}/api/projects/{{ $env.SEO_PROJECT_ID }}/jobs/verify-deployments?wait=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.SEO_API_KEY }}"
            },
            {
              "name": "x-correlation-id",
              "value": "=post-deploy-{{ $execution.id }}"
            }
