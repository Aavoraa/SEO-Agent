            },
            {
              "name": "x-correlation-id",
              "value": "=content-agent-{{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "timeout": 300000
        }
      },
      "name": "Generate brief (→ approval queue)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000
    },
    {
      "id": "1f29bfed-ed7a-440b-a376-ae29316d042e",
      "parameters": {
        "jsCode": "return [{ json: { workflow: 'content-agent', briefsCreated: $input.all().length, note: 'Briefs await human approval in the Approval Center.' } }];"
      },
