{
  "id": "pxSeoOnPageOpt01",
  "name": "SEO Agent – 05 On-Page Optimization",
  "nodes": [
    {
      "id": "4bbf912f-457f-4a63-a612-937b0332d417",
      "parameters": {
        "content": "## SEO Agent – 05 On-Page Optimization\nBranch A (webhook): page selected → current SEO analysis → AI optimisation → before/after recommendations → Approval Center.\nBranch B (every 30 min): approved changes → implementation via the website adapter (git/WordPress/API, or manual export) → verification on the live page → experiment monitoring.\nPOST {\"pageUrl\": \"https://www.phoenixxit.com/automation\"} to /webhook/seo-onpage.\n\nRequires n8n env vars: SEO_API_URL, SEO_API_KEY (service key), SEO_PROJECT_ID. All logic runs in the SEO Agent API; every call is retried 3× and failures trigger the Error Handler workflow.",
        "width": 520,
        "height": 260
      },
      "name": "Note 0985d2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -260
      ]
    },
    {
      "id": "ea86942d-7359-495b-ae04-aae9bc03344c",
      "parameters": {
        "httpMethod": "POST",
        "path": "seo-onpage",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Page selected (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "09a44c8c-a1cd-4628-aaa6-49419173d752"
    },
    {
      "id": "10889091-4753-4452-a990-639365368276",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "49fb8752-782b-47f1-a22b-909d5dd16f99",
              "leftValue": "={{ $json.body.pageUrl }}",
              "rightValue": "http",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Valid pageUrl?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "id": "43f38673-22ea-4025-ae68-f733fd05f5ac",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SEO_API_URL }}/api/projects/{{ $env.SEO_PROJECT_ID }}/jobs/onpage-optimize?wait=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.SEO_API_KEY }}"
            },
            {
              "name": "x-correlation-id",
              "value": "=onpage-{{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ pageUrl: $json.body.pageUrl }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "name": "AI on-page optimisation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        -80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000
    },
    {
      "id": "8d2c02ca-cea1-4948-ad32-05a4c31bb6af",
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { ok: r.status === 'succeeded', recommendations: r.output?.recommendations ?? 0, note: 'Recommendations are pending approval in the dashboard.' } }];"
      },
      "name": "Respond",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -80
      ]
    },
    {
      "id": "96fba3cf-3471-410e-a61b-a6fa7a0969bf",
      "parameters": {
        "jsCode": "return [{ json: { ok: false, error: 'Body must be {\"pageUrl\": \"https://...\"}' } }];"
      },
      "name": "Reject request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
