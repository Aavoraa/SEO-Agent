        },
        "options": {
          "timeout": 60000
        }
      },
      "name": "Load opportunities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    },
    {
      "id": "b0214ff9-2f17-49f2-a998-e7632d9896f0",
      "parameters": {
        "jsCode": "const opps = ($input.first().json.opportunities ?? [])\n  .filter(o => o.status === 'open' && ['high','critical'].includes(o.priority))\n  .slice(0, 3);\nreturn opps.map(o => ({ json: { id: o.id, title: o.title, score: o.score } }));"
      },
      "name": "Pick top 3 open high-priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "id": "c13709c4-b07d-4cb3-ab73-0af34ec624ad",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SEO_API_URL }}/api/projects/{{ $env.SEO_PROJECT_ID }}/content/opportunities/{{ $json.id }}/brief",
        "sendHeaders": true,
