      "parameters": {
        "content": "## SEO Agent – 03 Keyword Opportunity Discovery\nSchedule → Search Console → Keyword processor → Intent classification (rules, AI refines low-confidence only) → Clustering → Opportunity scoring → Database. Search volume is never fabricated; impressions are the demand signal.\n\nRequires n8n env vars: SEO_API_URL, SEO_API_KEY (service key), SEO_PROJECT_ID. All logic runs in the SEO Agent API; every call is retried 3× and failures trigger the Error Handler workflow.",
        "width": 520,
        "height": 260
      },
      "name": "Note 6b0c5f",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -260
      ]
    },
    {
      "id": "7c8c46ae-1fd6-4210-affd-1c0e480cbdde",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * 2"
            }
          ]
        }
      },
      "name": "Every Tuesday 03:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
