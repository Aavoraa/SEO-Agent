# ─────────────────────────────────────────────────────────────
#  Phoenixx SEO Agent – environment template
#  Copy to .env and fill in. NEVER commit .env.
#  Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Database ──
# Local dev without Docker: leave DATABASE_URL empty → embedded Postgres (PGlite) in ./.data/db
# Docker / production: postgres://USER:PASSWORD@HOST:5432/DB (docker-compose sets this for you)
DATABASE_URL=
POSTGRES_USER=seo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=phoenixx_seo

# ── Demo mode (separate database, clearly-labelled sample data, mock AI) ──
DEMO_MODE=false
DEMO_DATABASE_URL=pglite://./.data/demo-db

# ── API ──
API_PORT=4000
FRONTEND_URL=http://localhost:5173
# Public URL of the API (used for the Google OAuth redirect: <PUBLIC_API_URL>/api/integrations/google/callback)
PUBLIC_API_URL=http://localhost:4000
# Required in production (min 32 chars each)
JWT_SECRET=
APP_ENCRYPTION_KEY=
# Service key n8n uses to run jobs (x-api-key). Service keys can never approve changes.
SERVICE_API_KEY=
RATE_LIMIT_PER_MINUTE=300
# Optional: create the first admin on first start (otherwise use the setup screen)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Website ──
SEO_SITE_URL=https://www.phoenixxit.com/
CRAWL_MAX_PAGES=500
CRAWL_CONCURRENCY=3
CRAWL_DELAY_MS=250

# ── Google (Search Console + GA4, read-only) ──
# Option A (recommended for servers): service account JSON key; add the service-account email as a
#   user in Search Console and as a Viewer in GA4.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Option B: OAuth client (Web application). Authorised redirect URI: <PUBLIC_API_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (optional) a refresh token obtained elsewhere; otherwise use Settings → Integrations → Connect Google
GOOGLE_REFRESH_TOKEN=
# "sc-domain:phoenixxit.com" for a Domain property, or "https://www.phoenixxit.com/" for a URL-prefix property
SEARCH_CONSOLE_SITE_URL=
# Numeric GA4 property ID (Admin → Property settings), NOT the G-XXXX measurement ID
GA4_PROPERTY_ID=

# ── AI provider (claude | openai | mock | none) ──
AI_PROVIDER=none
# Default model per provider if empty: claude → claude-opus-5, openai → gpt-5
AI_MODEL=
# Optional cheaper model for bulk classification prompts (e.g. claude-haiku-4-5)
AI_MODEL_LIGHT=
# Optional reasoning effort for Claude: low | medium | high
AI_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_USD=50
AI_MAX_INPUT_CHARS=60000
AI_CACHE_TTL_HOURS=168

# ── Notifications (configure any; unset channels are disabled) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_EMAIL_TO=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Website deployment (see docs/deployment.md) ──
# sftp | ftp | local = file deployment with backup, verification and automatic restore (static sites like phoenixxit.com)
# manual | git | wordpress | api = adapters below. Nothing reaches the live site until an admin enables live deployment.
WEBSITE_DEPLOYMENT_PROVIDER=
DEPLOY_REMOTE_ROOT=/public_html
DEPLOY_ALLOWED_EXTENSIONS=.html,.htm
DEPLOY_VERIFY_BASE_URL=
DEPLOY_VERIFY_RETRIES=3
DEPLOY_VERIFY_DELAY_MS=5000
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_FILE=
SFTP_PASSPHRASE=
# Pin the server identity (shown by Settings → Deployment → Test connection)
SFTP_HOST_FINGERPRINT=
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
# true = FTPS explicit TLS (recommended) | implicit | false (plain FTP, refused unless FTP_ALLOW_INSECURE=true)
FTP_SECURE=true
FTP_TLS_SERVERNAME=
LOCAL_DEPLOY_ROOT=
# Demo mode deploys only to this local copy of the site
DEMO_SITE_DIR=./.data/demo-site

# ── Website implementation adapter (legacy name; WEBSITE_DEPLOYMENT_PROVIDER wins) (manual | git | wordpress | api) ──
# manual = export JSON/CSV/Markdown instructions (safe default for today's static phoenixxit.com)
# git    = commit edits to a branch of a local clone of the website repository (never pushes unless configured)
WEBSITE_ADAPTER=manual
WEBSITE_REPO_PATH=
WEBSITE_GIT_BRANCH_PREFIX=seo-agent/
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
WEBSITE_API_URL=
WEBSITE_API_TOKEN=
EXPORT_DIR=./exports

# ── Backlinks ──
# Search Console's API has no Links report. Either upload its CSV export in Dashboard → Backlinks (free),
# or set a provider so the weekly workflow pulls links automatically (DataForSEO: pay per request).
BACKLINK_PROVIDER=none
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Max links checked per run (oldest-checked first)
BACKLINK_VERIFY_LIMIT=200

# ── n8n ──
N8N_ENCRYPTION_KEY=change-me-long-random-string
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
# Values the workflows use (set after first start: create an API key with `npm run cli -- create-api-key n8n`,
# and copy the project id from the dashboard URL or `npm run cli -- list-projects`)
SEO_API_KEY=
SEO_PROJECT_ID=
# Signed events from the API to n8n (workflow 12): same secret in both, URL = <n8n>/webhook/seo-events
N8N_EVENTS_WEBHOOK_URL=
N8N_EVENTS_SECRET=

# ── SaaS / multi-tenant ──────────────────────────────────────────────
# Product name shown in the UI and emails (brand-neutral by default; orgs on a white-label plan override it)
PRODUCT_NAME=SEO Agent
# Public self-service sign-up (POST /api/auth/signup). The first user ever becomes platform admin.
SIGNUP_ENABLED=true
# Plan given to organizations created by sign-up: starter | growth | agency | enterprise
SIGNUP_DEFAULT_PLAN=starter
# Optional JSON file overriding/adding plans (limits, features) – see packages/shared/src/plans.ts
PLANS_FILE=
# Allow org webhooks / website detection to reach private or localhost addresses (dev/test only – SSRF guard)
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
OUTBOUND_ALLOW_PRIVATE_HOSTS=false
# Heatmaps (hm.js tracker): click/scroll events older than this many days are deleted
HEATMAP_RETENTION_DAYS=90
# Session recordings (rrweb via hm.js): deleted after this many days; a session stops recording past RECORDING_MAX_MB
RECORDING_RETENTION_DAYS=30
RECORDING_MAX_MB=25
