{
  "id": "pxSeoBacklinks01",
  "name": "SEO Agent – 10 Weekly Backlink Monitor",
  "nodes": [
    {
      "id": "8a4a5439-20de-451f-a91e-953108dae963",
      "parameters": {
        "content": "## SEO Agent – 10 Weekly Backlink Monitor\nPull backlinks from the configured provider (optional; CSV imports work without one) → check every linking page live → alert on lost links → 301 recommendations for links pointing at broken pages (admin approval). Monitoring only: never contacts sites or builds links.\n\nRequires n8n env vars: SEO_API_URL, SEO_API_KEY (service key), SEO_PROJECT_ID. All logic runs in the SEO Agent API; every call is retried 3× and failures trigger the Error Handler workflow.",
        "width": 520,
        "height": 260
      },
      "name": "Note daa8d1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -260
      ]
    },
    {
      "id": "b0e1896b-af5c-4130-a429-6cbaa138111d",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * 3"
            }
          ]
        }
      },
      "name": "Every Wednesday 04:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "7f8be5b5-b71a-46ea-a58c-15ce9d585e51",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SEO_API_URL }}/api/projects/{{ $env.SEO_PROJECT_ID }}/jobs/backlinks-sync?wait=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.SEO_API_KEY }}"
            },
            {
              "name": "x-correlation-id",
              "value": "=backlinks-{{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 1800000
        }
      },
      "name": "Sync backlinks from provider",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "onError": "continueRegularOutput",
      "notes": "Optional step – failures are logged in job_runs but do not stop the workflow."
    },
