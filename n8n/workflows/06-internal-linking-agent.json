      "id": "8d249e2b-2eed-4400-a61f-bea3740e470c",
      "parameters": {
        "content": "## SEO Agent – 06 Internal Linking Agent\nWebsite crawl (latest) → Build page/topic graph (TF-IDF similarity + inlink counts) → Find linking opportunities → AI anchor recommendations → Approval. Links are never inserted automatically.\n\nRequires n8n env vars: SEO_API_URL, SEO_API_KEY (service key), SEO_PROJECT_ID. All logic runs in the SEO Agent API; every call is retried 3× and failures trigger the Error Handler workflow.",
        "width": 520,
        "height": 260
      },
      "name": "Note f4ab12",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -260
      ]
    },
    {
      "id": "6d7d9b81-fa08-489d-a41c-9d3e7804947f",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * 1"
            }
          ]
        }
      },
      "name": "Every Monday 04:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "9c201fa4-b016-4f37-a862-8251770474d1",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SEO_API_URL }}/api/projects/{{ $env.SEO_PROJECT_ID }}/jobs/internal-links?wait=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.SEO_API_KEY }}"
            },
            {
              "name": "x-correlation-id",
              "value": "=internal-links-{{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"useAi\": true }",
        "options": {
          "timeout": 1800000
        }
      },
      "name": "Graph + opportunities + AI anchors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000
    },
    {
