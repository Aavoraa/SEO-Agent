{
  "id": "pxSeoContentAgnt",
  "name": "SEO Agent – 04 Content Opportunity Agent",
  "nodes": [
    {
      "id": "9073b453-1fa8-4bbf-a201-e7daec21d32f",
      "parameters": {
        "content": "## SEO Agent – 04 Content Opportunity Agent\nKeyword opportunities → Content gap analysis → AI → Content brief → HUMAN APPROVAL. Generates briefs for the top 3 high-priority opportunities; briefs land in the Approval Center. n8n can never approve or publish.\n\nRequires n8n env vars: SEO_API_URL, SEO_API_KEY (service key), SEO_PROJECT_ID. All logic runs in the SEO Agent API; every call is retried 3× and failures trigger the Error Handler workflow.",
        "width": 520,
        "height": 260
      },
      "name": "Note 784805",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -260
      ]
    },
    {
      "id": "72a68450-adb1-44dd-a102-3ccb596ead57",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * 3"
            }
          ]
        }
      },
      "name": "Every Wednesday 03:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "ce6afca5-c37b-4485-a381-4da27eeb832b",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SEO_API_URL }}/api/projects/{{ $env.SEO_PROJECT_ID }}/jobs/content-opportunities?wait=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.SEO_API_KEY }}"
            },
            {
