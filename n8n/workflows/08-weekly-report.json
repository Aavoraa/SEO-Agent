      "parameters": {
        "content": "## SEO Agent – 08 Weekly Report\nAnalytics + Search Console + Crawler + SEO engine → experiment evaluation → AI summary (from the numbers only; correlation ≠ causation) → HTML/Markdown report → Email (SMTP) + dashboard.\n\nRequires n8n env vars: SEO_API_URL, SEO_API_KEY (service key), SEO_PROJECT_ID. All logic runs in the SEO Agent API; every call is retried 3× and failures trigger the Error Handler workflow.",
        "width": 520,
        "height": 260
      },
      "name": "Note 52837a",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -260
      ]
    },
    {
      "id": "15fc9e31-f3bb-411f-a60a-7cbcaf0cfeaa",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "name": "Every Monday 08:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
